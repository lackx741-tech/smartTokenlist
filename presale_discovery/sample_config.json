{
  "discovery": {
    "manual_projects_file": "sample_inputs/manual_projects.json",
    "seed_urls_file": "sample_inputs/seed_urls.txt",
    "search_queries": [
      "crypto presale live",
      "past ico sold out",
      "upcoming token presale"
    ],
    "max_search_results": 8,
    "enable_serpapi": false
  },
  "onchain": {
